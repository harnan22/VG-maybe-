# Database Configuration
# For local PostgreSQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_DATABASE=testdb

# For Supabase - Choose ONE of the following connection methods:

# Option 1: Direct Connection (requires IPv6 support)
# DB_HOST=db.your-project-ref.supabase.co
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=your-supabase-password

# Option 2: Session Pooler (IPv4 compatible - RECOMMENDED for most environments)
# Get pooler details from: Supabase Dashboard -> Database -> Connection Pooling
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=6543
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=your-supabase-password

DB_HOST=your-database-host
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-database-password
DB_DATABASE=postgres

# SSL Configuration (required for Supabase)
DB_SSL_MODE=require
# Database Configuration Options
# DB_SYNC=false  # Disable synchronize (recommended for production)
# DB_MIGRATIONS_RUN=false  # Disable automatic migrations (recommended for production)

# ⚠️  IMPORTANT: Migration Management
# Automatic migrations are DISABLED by default for safety.
# 
# When you make changes to entities, you MUST run migrations manually:
# 1. Generate migration: npm run migration:generate
# 2. Review the generated migration file
# 3. Run migration: npm run migration:run
# 
# This prevents accidental data loss in production environments.

# Application Configuration
NODE_ENV=development
PORT=8000
API_PREFIX=api/v1

# JWT Configuration (optional)
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# Swagger Configuration
SWAGGER_TITLE=Boilerplate Service API
SWAGGER_DESCRIPTION=API documentation for Boilerplate service
SWAGGER_VERSION=1.0

# Clerk Configuration
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret
